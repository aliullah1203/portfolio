{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/about/layout,_N_T_/about/page,_N_T_/about"},"segmentPaths":["/_tree","/_full","/about/__PAGE__","/about","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2vjka9s58sp_-.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/28jhxkd7dhcxe.js\"/><script src=\"/_next/static/chunks/3cw03e4g1a0f8.js\" async=\"\"></script><script src=\"/_next/static/chunks/3g9awju12s9nv.js\" async=\"\"></script><script src=\"/_next/static/chunks/2hcaban3awdrw.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-1kfj6gjlp8k41.js\" async=\"\"></script><script src=\"/_next/static/chunks/456pv7klhvwpc.js\" async=\"\"></script><script src=\"/_next/static/chunks/3_0qx5cafyqpa.js\" async=\"\"></script><script src=\"/_next/static/chunks/3rlqakibw912p.js\" async=\"\"></script><script src=\"/_next/static/chunks/2-9_11ajn-kvp.js\" async=\"\"></script><title>Ali Ullah | Software Engineer</title><meta name=\"description\" content=\"Software Engineer specializing in Go, TypeScript, React.js, Next.js, Express.js, GraphQL, PostgreSQL, MongoDB, and scalable web applications.\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><div class=\"min-h-screen bg-slate-950 text-slate-100\"><header class=\"sticky top-0 z-50 border-b border-neutral-800 bg-neutral-950/95 backdrop-blur-sm\"><div class=\"mx-auto flex max-w-[1440px] items-center justify-between px-4 py-4 sm:px-6 lg:px-8\"><a class=\"flex items-center gap-2\" href=\"/\"><div class=\"flex h-10 w-10 items-center justify-center rounded-lg bg-accent-600\"><span class=\"text-sm font-bold text-white\">AU</span></div><span class=\"hidden font-semibold text-white sm:inline\">Ali Ullah</span></a><nav class=\"hidden items-center gap-8 lg:flex\"><a class=\"text-sm text-neutral-400 transition hover:text-neutral-200\" href=\"/\">Home</a><a class=\"text-sm text-neutral-400 transition hover:text-neutral-200\" href=\"/about\">About</a><a class=\"text-sm text-neutral-400 transition hover:text-neutral-200\" href=\"/skills\">Skills</a><a class=\"text-sm text-neutral-400 transition hover:text-neutral-200\" href=\"/projects\">Projects</a><a class=\"text-sm text-neutral-400 transition hover:text-neutral-200\" href=\"/experience\">Experience</a><a class=\"text-sm text-neutral-400 transition hover:text-neutral-200\" href=\"/blog\">Blog</a><a class=\"text-sm text-neutral-400 transition hover:text-neutral-200\" href=\"/contact\">Contact</a></nav><div class=\"flex items-center gap-3\"><a class=\"inline-flex items-center justify-center font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:ring-offset-2 focus:ring-offset-neutral-950 px-3 py-1.5 text-sm rounded border border-neutral-700 bg-neutral-900/50 text-neutral-200 hover:border-neutral-600 hover:bg-neutral-900 active:bg-neutral-800\" href=\"/aliullah.pdf\" download=\"aliullah_cv.pdf\">Resume</a></div></div></header><main class=\"mx-auto max-w-[1200px] px-4 py-16 sm:px-6 lg:px-8 space-y-16\"><section class=\"rounded-[2rem] border border-white/10 bg-slate-900/70 p-10 shadow-glow\"><div class=\"space-y-8\"><div><p class=\"text-sm uppercase tracking-[0.35em] text-brand-300\">About</p><h1 class=\"mt-4 text-5xl font-semibold text-white\">I&#x27;m Ali Ullah, a Junior Software Engineer.</h1></div><p class=\"max-w-3xl text-lg leading-8 text-slate-300\">I build scalable web applications using Go, TypeScript, Next.js, GraphQL, PostgreSQL, and MongoDB. My focus is on creating polished product experiences that perform reliably in production.</p><div class=\"grid gap-6 lg:grid-cols-3\"><div class=\"rounded-3xl border border-white/10 bg-slate-950/70 p-6\"><p class=\"text-sm uppercase tracking-[0.35em] text-brand-300\">Location</p><p class=\"mt-4 text-lg font-medium text-white\">Dhaka, Bangladesh</p></div><div class=\"rounded-3xl border border-white/10 bg-slate-950/70 p-6\"><p class=\"text-sm uppercase tracking-[0.35em] text-brand-300\">Email</p><p class=\"mt-4 text-lg font-medium text-white\">aliullah0301@gmail.com</p></div><div class=\"rounded-3xl border border-white/10 bg-slate-950/70 p-6\"><p class=\"text-sm uppercase tracking-[0.35em] text-brand-300\">Phone</p><p class=\"mt-4 text-lg font-medium text-white\">+8801648881803</p></div></div></div></section><section id=\"about\" class=\"relative\"><div class=\"mx-auto grid max-w-[1440px] gap-12 lg:grid-cols-[1.3fr_0.7fr] lg:items-center\"><div class=\"space-y-6\" style=\"opacity:0;transform:translateY(18px)\"><p class=\"text-sm font-semibold text-accent-400 uppercase tracking-wide\">About</p><h2 class=\"text-4xl font-bold text-white sm:text-5xl\">Building modern web experiences</h2><p class=\"max-w-2xl text-base leading-relaxed text-neutral-400\">I&#x27;m a Software Engineer focused on building performant, user-centric applications with Go, Next.js, TypeScript, PostgreSQL, and modern cloud-native tooling. I enjoy solving complex product problems and shipping polished end-to-end experiences.</p><a class=\"inline-flex items-center justify-center font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:ring-offset-2 focus:ring-offset-neutral-950 px-5 py-3 text-base rounded-md bg-accent-600 text-white hover:bg-accent-700 active:bg-accent-800 disabled:opacity-50 disabled:cursor-not-allowed\" href=\"#projects\">View My Work</a></div><div class=\"grid gap-4 sm:grid-cols-2 xl:grid-cols-3\" style=\"opacity:0;transform:translateY(18px)\"><div class=\"card flex flex-col items-start gap-3 p-4\"><span class=\"text-3xl font-bold text-accent-400\">1+</span><span class=\"text-xs font-semibold uppercase text-neutral-500 tracking-wide\">Years Experience</span></div><div class=\"card flex flex-col items-start gap-3 p-4\"><span class=\"text-3xl font-bold text-accent-400\">12+</span><span class=\"text-xs font-semibold uppercase text-neutral-500 tracking-wide\">Projects Delivered</span></div><div class=\"card flex flex-col items-start gap-3 p-4\"><span class=\"text-3xl font-bold text-accent-400\">15+</span><span class=\"text-xs font-semibold uppercase text-neutral-500 tracking-wide\">Technologies</span></div></div></div></section><section class=\"rounded-[2rem] border border-white/10 bg-slate-900/70 p-10 shadow-glow\"><div class=\"space-y-8\"><div><p class=\"text-sm uppercase tracking-[0.35em] text-brand-300\">What I bring</p><h2 class=\"mt-4 text-4xl font-semibold text-white\">Real product experience and engineering craftsmanship.</h2></div><div class=\"grid gap-6 lg:grid-cols-2\"><div class=\"rounded-3xl border border-white/10 bg-slate-950/70 p-6\"><h3 class=\"text-xl font-semibold text-white\">Product-focused mindset</h3><p class=\"mt-4 text-slate-300\">I deliver solutions that solve user problems, not just technical challenges, by balancing quality, performance, and usability.</p></div><div class=\"rounded-3xl border border-white/10 bg-slate-950/70 p-6\"><h3 class=\"text-xl font-semibold text-white\">Clean architecture</h3><p class=\"mt-4 text-slate-300\">I use modular, maintainable patterns in both frontend and backend systems so teams can iterate faster and ship safer changes.</p></div></div></div></section></main><footer class=\"border-t border-neutral-800 px-4 py-12 text-center text-sm text-neutral-500 sm:px-6 lg:px-8\"><p>© 2026 Ali Ullah. All rights reserved.</p></footer></div><!--$--><!--/$--><script src=\"/_next/static/chunks/28jhxkd7dhcxe.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[47922,[\\\"/_next/static/chunks/456pv7klhvwpc.js\\\",